package com.juaris.app.ui

import androidx.compose.foundation.background
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.items
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.material3.Card
import androidx.compose.material3.CardDefaults
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.res.stringResource
import androidx.compose.ui.text.font.FontFamily
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.text.style.TextAlign
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp
import com.juaris.app.R
import com.juaris.app.SecurityLogEntity

// Das neongrüne Markenzeichen von JUARIS
val NeonGiftgruen = Color(0xFF00E676)

/**
 * JUARIS LIVE SECURITY CONSOLE
 * Das hochperformante, native Jetpack Compose Äquivalent zum alten XML-Layout.
 * Optimiert für den weltweiten Massenmarkt: 100% flüssig via LazyColumn (Anti-RAM-Spike)
 * und vollkommen multilingual lokalisiert.
 */
@Composable
fun JuarisConsoleScreen(
    swarmStatusText: String, // Wird dynamisch aus dem Live-Flow der GlobalMeshEngine gespeist
    securityLogs: List<SecurityLogEntity> // Kommt direkt aus dem optimierten SecurityLogDao-Flow
) {
    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(Color(0xFF121212)) // Tiefes Cyber-Schwarz
            .padding(16.dp)
    ) {
        // 1. TITEL / APP NAME (Sprachunabhängig aus der strings.xml)
        Text(
            text = stringResource(R.string.app_ui_title_security).uppercase(),
            color = NeonGiftgruen,
            fontSize = 22.sp,
            fontWeight = FontWeight.Bold,
            textAlign = TextAlign.Center,
            modifier = Modifier
                .fillMaxWidth()
                .padding(bottom = 12.dp)
        )

        // 2. STATUS-KARTE
        Card(
            shape = RoundedCornerShape(4.dp),
            colors = CardDefaults.cardColors(containerColor = Color(0xFF1E1E1E)),
            modifier = Modifier
                .fillMaxWidth()
                .padding(bottom = 16.dp)
        ) {
            Column(modifier = Modifier.padding(12.dp)) {
                Text(
                    text = stringResource(R.string.status_guardian_active_offline),
                    color = Color.White,
                    fontWeight = FontWeight.Bold,
                    fontSize = 14.sp
                )
                Spacer(modifier = Modifier.height(4.dp))
                Text(
                    text = swarmStatusText, // e.g., "Schwarm-Signaturen lokal: ${logs.size} (P2P bereit)"
                    color = Color(0xFFB0BEC5),
                    fontSize = 12.sp
                )
            }
        }

        // 3. ÜBERSCHRIFT FÜR DAS BEDROHUNGS-LOG
        Text(
            text = stringResource(R.string.title_intercepted_logs),
            color = Color.White,
            fontWeight = FontWeight.Bold,
            fontSize = 14.sp,
            modifier = Modifier.padding(bottom = 8.dp)
        )

        // 4. KORREKTUR FÜR DIE WELTSPITZE: Die speicherschonende Live-Ereignis-Liste!
        // Läuft über eine LazyColumn. Sie rendert nur die Kacheln, die der Nutzer sieht.
        // Selbst bei Millionen Logs im Hintergrund bleibt das Handy absolut ruckelfrei!
        Box(
            modifier = Modifier
                .weight(1f)
                .fillMaxWidth()
                .background(Color(0xFF1E1E1E), shape = RoundedCornerShape(2.dp))
                .padding(8.dp)
        ) {
            if (securityLogs.isEmpty()) {
                // Wartezustand (Sprachunterstützt)
                Text(
                    text = "[System] " + stringResource(R.string.logs_waiting_for_events),
                    color = Color(0xFFE0E0E0),
                    fontFamily = FontFamily.Monospace,
                    fontSize = 12.sp
                )
            } else {
                LazyColumn(
                    modifier = Modifier.fillMaxSize(),
                    verticalArrangement = Arrangement.spacedBy(6.dp)
                ) {
                    items(securityLogs) { log ->
                        Text(
                            text = "[${log.module}] ${log.description}\n-> ${log.details}",
                            color = when (log.status) {
                                "BLOCKED" -> Color(0xFFFF3333) // Aggressives Warn-Rot bei Abwehr
                                "WARNING" -> Color(0xFFFF9800) // Warn-Orange bei Risiken
                                else -> Color(0xFFE0E0E0)      // Dezentes Hellgrau für Standard-Infos
                            },
                            fontFamily = FontFamily.Monospace,
                            fontSize = 12.sp,
                            modifier = Modifier.fillMaxWidth()
                        )
                    }
                }
            }
        }
    }
}
