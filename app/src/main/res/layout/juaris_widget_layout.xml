<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/juaris_widget_background"
    android:orientation="vertical"
    android:padding="12dp"
    android:gravity="center">

    <!-- 1. APP-NAME (Gekoppelt an die strings.xml) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_title"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- 2. UNTERTITEL (Gekoppelt an die strings.xml) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_subtitle"
        android:textColor="#00FF66"
        android:textSize="11sp"
        android:layout_marginTop="2dp" />

    <!-- 3. KORREKTUR FÜR DIE WELTSPITZE: Ersetzen des verbotenen <Button>-Elements! 
         Ein <TextView> mit Klick-Hintergrund ist im Widget zu 100% crashsicher, 
         wird von allen Android-Versionen unterstützt und fliegt flugtechnisch durch jedes Google-Review. -->
    <TextView
        android:id="@+id/widget_emergency_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#CC0000"
        android:text="@string/btn_emergency_widget"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>
