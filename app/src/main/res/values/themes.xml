<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Das Haupt-Theme für die Juaris Security Suite - Perfekt abgestimmt auf das Hacker-Green-Design -->
    <style name="Theme.Juaris" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Akzentfarben (Zuweisung deiner NeonGiftgruen-Farbe als Hex-Wert #00E676) -->
        <item name="colorPrimary">#00E676</item>
        <item name="colorSecondary">#00E676</item>
        
        <!-- KORREKTUR: Verhindert den grellen weißen Startblitz auf OLED-Displays! -->
