<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Blockiert jegliche Cloud-Sicherung auf Google-Servern im Hintergrund -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    
    <!-- Erlaubt ausschließlich den physischen Kabel- oder Direkt-Transfer, wenn der Nutzer auf ein neues Handy umzieht -->
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
